# Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dsa_tracker?retryWrites=true&w=majority

# JWT Secret — use a long random string (e.g., run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Token expiry
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
